{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Tunefold",
  "version": "0.5.0",
  "identifier": "io.github.hercegman.tunefold",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Tunefold",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "linux": {
      "deb": {
        "depends": [
          "gstreamer1.0-plugins-good",
          "gstreamer1.0-plugins-bad",
          "gstreamer1.0-plugins-ugly",
          "gstreamer1.0-libav"
        ],
        "desktopTemplate": "tunefold.desktop"
      },
      "rpm": {
        "depends": [
          "gstreamer1-plugins-good"
        ],
        "desktopTemplate": "tunefold.desktop"
      }
    },
    "externalBin": [
      "binaries/backend",
      "binaries/ffmpeg",
      "binaries/ffprobe"
    ],
    "fileAssociations": [
      {
        "ext": [
          "mp3",
          "m4a",
          "flac",
          "opus",
          "wav",
          "ogg",
          "oga",
          "aac"
        ],
        "name": "Audio file",
        "description": "Audio file",
        "mimeType": "audio/mpeg;audio/mp4;audio/x-m4a;audio/flac;audio/x-flac;audio/ogg;audio/opus;audio/wav;audio/x-wav;audio/aac",
        "role": "Viewer",
        "rank": "Alternate"
      }
    ],
    "category": "Music"
  }
}

[Desktop Entry]
Type=Application
Name={{name}}
GenericName=Music Player
{{#if comment}}Comment={{comment}}{{/if}}
Categories={{categories}}
Icon={{icon}}
Terminal=false
StartupNotify=true
StartupWMClass=Tunefold
MimeType=audio/mpeg;audio/mp4;audio/x-m4a;audio/flac;audio/x-flac;audio/ogg;audio/opus;audio/wav;audio/x-wav;audio/aac;
Exec={{exec}} %F
